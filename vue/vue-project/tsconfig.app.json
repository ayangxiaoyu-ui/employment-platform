{
  "extends": "@vue/tsconfig/tsconfig.dom.json",
  "include": [
    "env.d.ts",
    "src/**/*",
    "src/**/*.vue"
  ],
  "exclude": [
    "src/**/__tests__/*"
  ],
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo",
    "baseUrl": ".", // ← 加上这一行，非常关键！
    "paths": {
      "@/*": [
        "./src/*"
      ]
    },
    // 建议再加上这一行（新版 Vite + TS 推荐）
    "moduleResolution": "bundler"
  }
}